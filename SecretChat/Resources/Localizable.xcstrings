      }
    },
    "Model działa w całości na tym iPhonie. Rozmowa nie opuszcza telefonu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The model runs entirely on this iPhone. The conversation never leaves your phone."
