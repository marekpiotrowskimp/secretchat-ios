    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to take photos you send to the model. Photos never leave your phone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparat służy do robienia zdjęć, które wysyłasz do modelu. Zdjęcia nie opuszczają telefonu."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone is used to dictate messages. Speech is recognized on the phone and never sent anywhere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon służy do dyktowania wiadomości. Mowa jest rozpoznawana na telefonie i nie jest nigdzie wysyłana."
          }
        }
      }
